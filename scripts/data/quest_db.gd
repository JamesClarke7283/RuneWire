class_name QuestDB
## All quest definitions. Objective types:
##   kill(target: enemy id | "faction:magic" | "faction:tech" | "any"), collect(item), reach(location),
##   talk(npc), buy_part(part|any), buy(item|any), spawn(part|any), weld, build(tag), drive(meters),
##   altitude(meters), deliver(zone), challenge(challenge id, count = medal tier 1..3),
##   equip(weapon base in a hotbar weapon slot), kill_with(weapon kind "gun"|"spell"|"melee" or base),
##   kill_elite(enemy id | any), open_chest(any | vault), harvest(item | ore | herb | any), scavenge,
##   craft(recipe | station:<id> | weapon | pouch | any), upgrade (a weapon), enchant (at the altar),
##   pouches(count equipped), artisan(rank), talent(points spent), level(player level), learn(schematics)
##   kill_with also takes "school:tech" / "school:magic".
## Rewards: gold, xp, parts, items (incl. pouches and "sch_<recipe>" schematics), unlock_parts,
## weapons [{base, rarity, level}] (base "random" rolls one).
## "on_accept": {items, weapons} are handed over when the quest is taken.

